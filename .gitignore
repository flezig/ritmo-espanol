# Dependencies and package-manager caches
/node_modules/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests and generated reports
/coverage/
/playwright-report/
/test-results/

# Framework and production output
/.next/
/.vinext/
/dist/
/out/
/.wrangler/
/.vercel/

# TypeScript caches
*.tsbuildinfo

# Local environment; a documented template may be committed
.env*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local certificates and archives
*.pem
/*.zip

# Temporary local workspaces
/outputs/
/work/
